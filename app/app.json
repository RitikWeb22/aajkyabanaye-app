{
  "expo": {
    "name": "AajKyaBanaye",
    "slug": "aajkyabanaye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aajkyabanaye",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aajkyabanaye.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["swiggy"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFF9F0"
      },
      "package": "com.aajkyabanaye.app"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFF9F0",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
