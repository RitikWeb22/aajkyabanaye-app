AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT_PER_USER=5
AI_REQUEST_TIMEOUT_MS=20000

GROCERY_PROVIDER=copy_list
INSTAMART_API_KEY=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CONTACT_EMAIL=

# Cloudinary
