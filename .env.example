# ==========================================
# AajKyaBanaye — Environment Variables
# ==========================================

# ------------------------------------------
# App (Public — Safe to bundle with app)
# ------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_BASE_URL=

# ------------------------------------------
# Server (Private — Server-side only)
# ------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URL=
MONGODB_URI=
MONGODB_DB_NAME=aajkyabanaya

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CORS_ORIGINS=*

RECIPE_PROVIDER_PRIMARY=themealdb
THEMEALDB_API_KEY=1
SPOONACULAR_API_KEY=

AI_PROVIDER=gemini
GEMINI_API_KEY=
