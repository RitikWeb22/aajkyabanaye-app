{
  "name": "aajkyabanaye",
  "version": "1.0.0",
  "private": true,
  "description": "AajKyaBanaye - Your next delicious meal starts here",
  "scripts": {
    "start": "concurrently -n \"API,APP\" -c \"cyan,green\" \"npm run server\" \"npm run app\"",
    "app": "npm --prefix app start",
    "app:android": "npm --prefix app run android",
    "app:ios": "npm --prefix app run ios",
    "app:web": "npm --prefix app run web",
    "server": "npm --prefix server run dev",
    "build:apk": "npm --prefix app run build:apk",
    "build:playstore": "npm --prefix app run build:playstore",
    "build:ios": "npm --prefix app run build:ios",
    "lint": "npm --prefix app run lint && npm --prefix server run lint",
    "typecheck": "npm --prefix app run typecheck && npm --prefix server run typecheck"
  },
  "keywords": [
    "react-native",
    "expo",
    "cooking",
    "recipes",
    "groceries",
    "meal-planner"
  ],
  "author": "Ritik",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
